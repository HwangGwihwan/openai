<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springai.mapper.HashTagMapper">
	<insert id="saveTags" parameterType="map">
		INSERT INTO hashtag (no, tag_text)
		VALUES
		<foreach collection="tags" item="tag" separator=",">
			(#{no}, #{tag})
		</foreach>
	</insert>
	
	<select id="findTagsByNo" resultType="string" parameterType="int">
		SELECT tag_text
		FROM hashtag
		WHERE no = #{no}
	</select>
</mapper>